  "narration_segments": [
    {"id":"n1","text":"A database query needs one record, but the collection is huge.","start_second":0,"duration_second":5,"audio_path":null,"emotion":"surprise","delivery":"energetic","delivery_speed":1.0,"pause_after_ms":100,"voice":"am_michael"},
    {"id":"n2","text":"Without an index, it may scan the records one by one.","start_second":5,"duration_second":5,"audio_path":null,"emotion":"frustration","delivery":"urgent","delivery_speed":1.0,"pause_after_ms":100,"voice":"am_michael"},
    {"id":"n3","text":"An index is an organised shortcut. Many databases use tree-shaped indexes such as B-trees.","start_second":10,"duration_second":5,"audio_path":null,"emotion":"surprise","delivery":"energetic","delivery_speed":1.0,"pause_after_ms":100,"voice":"am_michael"},
    {"id":"n4","text":"The database follows the branch from root to child to the matching record.","start_second":15,"duration_second":5,"audio_path":null,"emotion":"excitement","delivery":"energetic","delivery_speed":1.0,"pause_after_ms":100,"voice":"am_michael"},
    {"id":"n5","text":"The trade-off is storage and maintenance work in exchange for fewer search steps in this illustrative example.","start_second":20,"duration_second":5,"audio_path":null,"emotion":"neutral","delivery":"calm","delivery_speed":1.0,"pause_after_ms":100,"voice":"am_michael"},
