VECTORFORGE_FPS=30
# AI planning provider. Groq is the primary provider; Ollama is the optional fallback.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=medium
GROQ_TIMEOUT=120
LLM_FALLBACK_PROVIDER=ollama
LLM_MAX_RETRIES=2
LLM_CACHE_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
KOKORO_VOICE=am_michael
KOKORO_SPEED=1.0
KOKORO_LANG=a
KOKORO_MODEL=Kokoro-82M
KOKORO_MODEL_VERSION=82M
KOKORO_REPO_ID=hexgrad/Kokoro-82M
KOKORO_MODEL_DIR=C:\\Models\\kokoro
# First run may fetch missing Kokoro-82M files; set 1 after the cache is populated.
KOKORO_OFFLINE=0
KOKORO_DEVICE=auto
FREESOUND_API_KEY=
FREESOUND_ACCESS_TOKEN=
PIXABAY_API_KEY=

AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
NARRATION_VOLUME=1.0
SFX_VOLUME=0.35
MUSIC_VOLUME=0.12
MUSIC_DUCKING_ENABLED=true
MUSIC_ENABLED=false
VIDEO_FPS=30
AUDIO_REQUIRED=true

